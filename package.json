{
  "name": "shipone",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "media/branding/icon-128.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark",
    "image": "media/branding/banner.png"
  },
  "keywords": [
    "vscode",
    "productivity",
    "projects",
    "focus",
    "roadmap",
    "ship"
  ],
  "version": "0.0.6",
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pdpunto/shipone.git"
  },
  "homepage": "https://github.com/pdpunto/shipone#readme",
  "bugs": {
    "url": "https://github.com/pdpunto/shipone/issues"
  },
  "license": "MIT",
  "publisher": "pdpunto",
  "activationEvents": [
    "onView:shipone.projectsView",
    "onCommand:shipone.showWelcome",
    "onCommand:shipone.quickCreateProject",
    "onCommand:shipone.searchProject",
    "onCommand:shipone.scanTodos",
    "onCommand:shipone.generateAiContext",
    "onCommand:shipone.recoverStorage"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shipone.showWelcome",
        "title": "%command.showWelcome.title%",
        "category": "ShipOne"
      },
      {
        "command": "shipone.createProject",
        "title": "%command.createProject.title%",
        "category": "ShipOne",
        "icon": "$(add)"
      },
      {
        "command": "shipone.quickCreateProject",
        "title": "%command.quickCreateProject.title%",
        "category": "ShipOne",
        "icon": "$(zap)"
      },
      {
        "command": "shipone.openProjectsRoot",
        "title": "%command.openProjectsRoot.title%",
        "category": "ShipOne",
        "icon": "$(folder-library)"
      },
      {
        "command": "shipone.chooseProject",
        "title": "%command.chooseProject.title%",
        "category": "ShipOne",
        "icon": "$(folder-opened)"
      },
      {
        "command": "shipone.editMvpChecklist",
        "title": "%command.editMvpChecklist.title%",
        "category": "ShipOne",
        "icon": "$(checklist)"
      },
      {
        "command": "shipone.markMvpItemDone",
        "title": "%command.markMvpItemDone.title%",
        "category": "ShipOne",
        "icon": "$(check)"
      },
      {
        "command": "shipone.syncStatusFile",
        "title": "%command.syncStatusFile.title%",
        "category": "ShipOne",
        "icon": "$(sync)"
      },
      {
        "command": "shipone.recoverStorage",
        "title": "%command.recoverStorage.title%",
        "category": "ShipOne",
        "icon": "$(database)"
      },
      {
        "command": "shipone.connectGithub",
        "title": "%command.connectGithub.title%",
        "category": "ShipOne",
        "icon": "$(account)"
      },
      {
        "command": "shipone.detectBlockers",
        "title": "%command.detectBlockers.title%",
        "category": "ShipOne",
        "icon": "$(warning)"
      },
      {
        "command": "shipone.generateAiContext",
        "title": "%command.generateAiContext.title%",
        "category": "ShipOne",
        "icon": "$(file-code)"
      },
      {
        "command": "shipone.scanTodos",
        "title": "%command.scanTodos.title%",
        "category": "ShipOne",
        "icon": "$(checklist)"
      },
      {
        "command": "shipone.focusMode",
        "title": "%command.focusMode.title%",
        "category": "ShipOne",
        "icon": "$(eye)"
      },
      {
        "command": "shipone.exitFocusMode",
        "title": "%command.exitFocusMode.title%",
        "category": "ShipOne",
        "icon": "$(eye-closed)"
      },
      {
        "command": "shipone.weeklyReview",
        "title": "%command.weeklyReview.title%",
        "category": "ShipOne",
        "icon": "$(calendar)"
      },
      {
        "command": "shipone.freezeProject",
        "title": "%command.freezeProject.title%",
        "category": "ShipOne",
        "icon": "$(debug-pause)"
      },
      {
        "command": "shipone.resumeProject",
        "title": "%command.resumeProject.title%",
        "category": "ShipOne",
        "icon": "$(play)"
      },
      {
        "command": "shipone.toggleFavorite",
        "title": "%command.toggleFavorite.title%",
        "category": "ShipOne",
        "icon": "$(star)"
      },
      {
        "command": "shipone.searchProject",
        "title": "%command.searchProject.title%",
        "category": "ShipOne",
        "icon": "$(search)"
      },
      {
        "command": "shipone.openProject",
        "title": "%command.openProject.title%",
        "category": "ShipOne",
        "icon": "$(folder-opened)"
      },
      {
        "command": "shipone.markProjectIdea",
        "title": "%command.markProjectIdea.title%",
        "category": "ShipOne",
        "icon": "$(light-bulb)"
      },
      {
        "command": "shipone.markProjectActive",
        "title": "%command.markProjectActive.title%",
        "category": "ShipOne",
        "icon": "$(play)"
      },
      {
        "command": "shipone.markProjectPaused",
        "title": "%command.markProjectPaused.title%",
        "category": "ShipOne",
        "icon": "$(debug-pause)"
      },
      {
        "command": "shipone.markProjectFinished",
        "title": "%command.markProjectFinished.title%",
        "category": "ShipOne",
        "icon": "$(check)"
      },
      {
        "command": "shipone.editNextAction",
        "title": "%command.editNextAction.title%",
        "category": "ShipOne",
        "icon": "$(pencil)"
      },
      {
        "command": "shipone.clearNextAction",
        "title": "%command.clearNextAction.title%",
        "category": "ShipOne",
        "icon": "$(trash)"
      },
      {
        "command": "shipone.deleteProject",
        "title": "%command.deleteProject.title%",
        "category": "ShipOne",
        "icon": "$(trash)"
      },
      {
        "command": "shipone.openStatusFile",
        "title": "%command.openStatusFile.title%",
        "category": "ShipOne",
        "icon": "$(file-code)"
      },
      {
        "command": "shipone.refreshProjects",
        "title": "%command.refreshProjects.title%",
        "category": "ShipOne",
        "icon": "$(refresh)"
      }
    ],
    "submenus": [
      {
        "id": "shipone.moreActions",
        "label": "%menu.moreActions.title%",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "shipone.createProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.chooseProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.searchProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "submenu": "shipone.moreActions",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        }
      ],
      "shipone.moreActions": [
        {
          "command": "shipone.openProjectsRoot"
        },
        {
          "command": "shipone.editMvpChecklist"
        },
        {
          "command": "shipone.markMvpItemDone"
        },
        {
          "command": "shipone.syncStatusFile"
        },
        {
          "command": "shipone.recoverStorage"
        },
        {
          "command": "shipone.connectGithub"
        },
        {
          "command": "shipone.detectBlockers"
        },
        {
          "command": "shipone.generateAiContext"
        },
        {
          "command": "shipone.focusMode",
          "when": "view == shipone.projectsView && !shipone.focusMode"
        },
        {
          "command": "shipone.exitFocusMode",
          "when": "view == shipone.projectsView && shipone.focusMode"
        },
        {
          "command": "shipone.weeklyReview"
        },
        {
          "command": "shipone.openStatusFile"
        },
        {
          "command": "shipone.refreshProjects"
        }
      ],
      "view/item/context": [
        {
          "command": "shipone.openProject",
          "when": "view == shipone.projectsView && viewItem == shipone.project",
          "group": "inline"
        },
        {
          "command": "shipone.toggleFavorite",
          "when": "view == shipone.projectsView && viewItem == shipone.project",
          "group": "inline"
        },
        {
          "command": "shipone.editNextAction",
          "when": "view == shipone.projectsView && viewItem == shipone.project",
          "group": "inline"
        },
        {
          "command": "shipone.markProjectIdea",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.markProjectActive",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.markProjectPaused",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.markProjectFinished",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.clearNextAction",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.deleteProject",
          "when": "view == shipone.projectsView && viewItem == shipone.project",
          "group": "inline"
        },
        {
          "command": "shipone.openStatusFile",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shipone",
          "title": "ShipOne",
          "icon": "media/branding/icon-128.png"
        }
      ]
    },
    "views": {
      "shipone": [
        {
          "id": "shipone.projectsView",
          "name": "%view.projects.name%"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "shipone-getting-started",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "create-project",
            "title": "%walkthrough.gettingStarted.step.createProject.title%",
            "description": "%walkthrough.gettingStarted.step.createProject.description%",
            "media": {
              "markdown": "media/walkthrough/getting-started.md"
            },
            "completionEvents": [
              "onCommand:shipone.createProject"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "shipone.projectsRoot": {
          "type": "string",
          "default": "C:\\dev\\proyectos",
          "description": "%configuration.projectsRoot.description%"
        },
        "shipone.defaultVisibility": {
          "type": "string",
          "enum": [
            "private",
            "public"
          ],
          "default": "private",
          "description": "%configuration.defaultVisibility.description%"
        },
        "shipone.defaultProjectType": {
          "type": "string",
          "enum": [
            "blank",
            "react-vite",
            "nextjs",
            "python",
            "node-api"
          ],
          "default": "blank",
          "description": "%configuration.defaultProjectType.description%"
        },
        "shipone.createGitRepoByDefault": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.createGitRepoByDefault.description%"
        },
        "shipone.createGitHubRepoByDefault": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.createGitHubRepoByDefault.description%"
        },
        "shipone.enforceOneActiveProject": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enforceOneActiveProject.description%"
        },
        "shipone.createStatusFileByDefault": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.createStatusFileByDefault.description%"
        },
        "shipone.defaultPackageManager": {
          "type": "string",
          "enum": [
            "npm",
            "pnpm",
            "yarn"
          ],
          "default": "npm",
          "description": "%configuration.defaultPackageManager.description%"
        },
        "shipone.customTemplateFolder": {
          "type": "string",
          "default": "",
          "description": "%configuration.customTemplateFolder.description%"
        },
        "shipone.openAfterCreate": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.openAfterCreate.description%"
        },
        "shipone.inactiveWarningDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "description": "%configuration.inactiveWarningDays.description%"
        },
        "shipone.staleWarningDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "%configuration.staleWarningDays.description%"
        },
        "shipone.showFinishedProjects": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showFinishedProjects.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "validate:translations": "node scripts/validate-translations.mjs",
    "validate:utf8": "node scripts/validate-utf8.mjs",
    "version:current": "node scripts/semver.mjs current",
    "version:tag": "node scripts/semver.mjs tag",
    "version:validate": "node scripts/semver.mjs validate-tag",
    "release:tag": "node scripts/semver.mjs create-tag",
    "release:beta": "node scripts/semver.mjs create-beta-tag",
    "release:notes": "node scripts/build-release-notes.mjs",
    "package:vsix": "npx @vscode/vsce package",
    "validate:package": "node scripts/validate-package.mjs",
    "test": "npm run compile && node --test test/shipone.test.js test/localization.test.js test/translationKeys.test.js test/walkthrough.test.js test/semver.test.js test/releaseNotes.test.js test/packageMetadata.test.js test/readme.test.js test/vsceIgnore.test.js test/packageValidation.test.js test/betaReleaseWorkflow.test.js test/betaFeedback.test.js test/onboarding.test.js test/utf8Encoding.test.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --check \"src/**/*.ts\" \"*.json\" \"docs/**/*.md\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"*.json\" \"docs/**/*.md\""
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "@types/vscode": "^1.115.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "6.0.3"
  }
}
