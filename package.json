{
  "name": "shipone",
  "displayName": "ShipOne",
  "description": "ShipOne ayuda a crear y seguir proyectos desde VS Code",
  "icon": "media/branding/icon-128.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark",
    "image": "media/branding/banner.png"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:shipone.projectsView",
    "onCommand:shipone.showWelcome",
    "onCommand:shipone.searchProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "shipone.showWelcome", "title": "Bienvenida", "category": "ShipOne" },
      { "command": "shipone.createProject", "title": "Crear", "category": "ShipOne", "icon": "$(add)" },
      { "command": "shipone.openProjectsRoot", "title": "Raíz", "category": "ShipOne", "icon": "$(folder-library)" },
      { "command": "shipone.openProjectQuickPick", "title": "Abrir", "category": "ShipOne", "icon": "$(folder-opened)" },
      { "command": "shipone.editMvpChecklist", "title": "Checklist MVP", "category": "ShipOne", "icon": "$(checklist)" },
      { "command": "shipone.markMvpItemDone", "title": "Marcar MVP", "category": "ShipOne", "icon": "$(check)" },
      { "command": "shipone.syncStatusFile", "title": "STATUS.md", "category": "ShipOne", "icon": "$(sync)" },
      { "command": "shipone.connectGithub", "title": "Conectar GitHub", "category": "ShipOne", "icon": "$(account)" },
      { "command": "shipone.detectBlockers", "title": "Bloqueadores", "category": "ShipOne", "icon": "$(warning)" },
      { "command": "shipone.focusMode", "title": "Focus", "category": "ShipOne", "icon": "$(eye)" },
      { "command": "shipone.exitFocusMode", "title": "Salir focus", "category": "ShipOne", "icon": "$(eye-closed)" },
      { "command": "shipone.weeklyReview", "title": "Weekly review", "category": "ShipOne", "icon": "$(calendar)" },
      { "command": "shipone.freezeProject", "title": "Congelar", "category": "ShipOne", "icon": "$(debug-pause)" },
      { "command": "shipone.resumeProject", "title": "Reanudar", "category": "ShipOne", "icon": "$(play)" },
      { "command": "shipone.toggleFavorite", "title": "Favorito", "category": "ShipOne", "icon": "$(star)" },
      { "command": "shipone.searchProject", "title": "Buscar", "category": "ShipOne", "icon": "$(search)" },
      { "command": "shipone.openProject", "title": "Abrir", "category": "ShipOne", "icon": "$(folder-opened)" },
      { "command": "shipone.changeProjectStatus", "title": "Cambiar estado", "category": "ShipOne" },
      { "command": "shipone.markProjectIdea", "title": "Idea", "category": "ShipOne" },
      { "command": "shipone.markProjectActive", "title": "Active", "category": "ShipOne" },
      { "command": "shipone.markProjectPaused", "title": "Paused", "category": "ShipOne" },
      { "command": "shipone.markProjectFinished", "title": "Finished", "category": "ShipOne" },
      { "command": "shipone.editNextAction", "title": "Next", "category": "ShipOne", "icon": "$(pencil)" },
      { "command": "shipone.clearNextAction", "title": "Limpiar next", "category": "ShipOne" },
      { "command": "shipone.openStatusFile", "title": "STATUS.md", "category": "ShipOne", "icon": "$(file-code)" },
      { "command": "shipone.refreshProjects", "title": "Refrescar", "category": "ShipOne", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "shipone.createProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.openProjectsRoot",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.openProjectQuickPick",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.searchProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.editMvpChecklist",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.markMvpItemDone",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.syncStatusFile",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.connectGithub",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.detectBlockers",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.focusMode",
          "when": "view == shipone.projectsView && !shipone.focusMode",
          "group": "navigation"
        },
        {
          "command": "shipone.exitFocusMode",
          "when": "view == shipone.projectsView && shipone.focusMode",
          "group": "navigation"
        },
        {
          "command": "shipone.weeklyReview",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.freezeProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.resumeProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.toggleFavorite",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.openStatusFile",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.refreshProjects",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "shipone.openProject",
          "when": "view == shipone.projectsView && viewItem == shipone.project",
          "group": "inline"
        },
        {
          "command": "shipone.toggleFavorite",
          "when": "view == shipone.projectsView && viewItem == shipone.project",
          "group": "inline"
        },
        {
          "command": "shipone.editNextAction",
          "when": "view == shipone.projectsView && viewItem == shipone.project",
          "group": "inline"
        },
        {
          "command": "shipone.markProjectIdea",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.markProjectActive",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.markProjectPaused",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.markProjectFinished",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.editNextAction",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.clearNextAction",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.openStatusFile",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shipone",
          "title": "ShipOne",
          "icon": "media/branding/icon-128.png"
        }
      ]
    },
    "views": {
      "shipone": [
        {
          "id": "shipone.projectsView",
          "name": "ShipOne"
        }
      ]
    },
    "configuration": {
      "title": "ShipOne",
      "properties": {
        "shipone.projectsRoot": {
          "type": "string",
          "default": "C:\\dev\\proyectos",
          "description": "Ruta base donde ShipOne crea y busca proyectos."
        },
        "shipone.defaultVisibility": {
          "type": "string",
          "enum": [
            "private",
            "public"
          ],
          "default": "private",
          "description": "Visibilidad por defecto para nuevos repositorios GitHub."
        },
        "shipone.defaultProjectType": {
          "type": "string",
          "enum": [
            "blank",
            "react-vite",
            "nextjs",
            "python"
          ],
          "default": "blank",
          "description": "Tipo por defecto para nuevos proyectos."
        },
        "shipone.createGitRepoByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Preseleccionar Git como opcion por defecto al crear proyectos."
        },
        "shipone.createGitHubRepoByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Preseleccionar la creacion de repo GitHub al crear proyectos."
        },
        "shipone.openAfterCreate": {
          "type": "boolean",
          "default": true,
          "description": "Abrir el proyecto recien creado al terminar."
        },
        "shipone.inactiveWarningDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "description": "Dias sin abrir antes de mostrar aviso de inactividad."
        },
        "shipone.staleWarningDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Dias sin abrir antes de mostrar aviso fuerte."
        },
        "shipone.showFinishedProjects": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar o esconder la seccion Finished en la vista."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/vscode": "latest",
    "typescript": "latest"
  }
}
