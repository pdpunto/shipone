{
  "name": "shipone",
  "displayName": "ShipOne",
  "description": "ShipOne ayuda a crear y seguir proyectos desde VS Code",
  "icon": "media/branding/icon-128.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark",
    "image": "media/branding/banner.png"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:shipone.projectsView",
    "onCommand:shipone.showWelcome",
    "onCommand:shipone.searchProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "shipone.showWelcome", "title": "ShipOne: Mostrar bienvenida" },
      { "command": "shipone.createProject", "title": "ShipOne: Crear proyecto", "icon": "$(add)" },
      { "command": "shipone.openProjectQuickPick", "title": "ShipOne: Abrir proyecto", "icon": "$(folder-opened)" },
      { "command": "shipone.editMvpChecklist", "title": "ShipOne: Editar checklist MVP", "icon": "$(checklist)" },
      { "command": "shipone.markMvpItemDone", "title": "ShipOne: Marcar tarea MVP hecha", "icon": "$(check)" },
      { "command": "shipone.syncStatusFile", "title": "ShipOne: Sincronizar STATUS.md", "icon": "$(sync)" },
      { "command": "shipone.focusMode", "title": "ShipOne: Focus mode", "icon": "$(eye)" },
      { "command": "shipone.exitFocusMode", "title": "ShipOne: Salir de focus mode", "icon": "$(eye-closed)" },
      { "command": "shipone.weeklyReview", "title": "ShipOne: Weekly review", "icon": "$(calendar)" },
      { "command": "shipone.freezeProject", "title": "ShipOne: Congelar proyecto", "icon": "$(debug-pause)" },
      { "command": "shipone.resumeProject", "title": "ShipOne: Reanudar proyecto", "icon": "$(play)" },
      { "command": "shipone.toggleFavorite", "title": "ShipOne: Alternar favorito", "icon": "$(star)" },
      { "command": "shipone.searchProject", "title": "ShipOne: Buscar proyecto", "icon": "$(search)" },
      { "command": "shipone.openProject", "title": "ShipOne: Abrir proyecto", "icon": "$(folder-opened)" },
      { "command": "shipone.changeProjectStatus", "title": "ShipOne: Cambiar estado" },
      { "command": "shipone.editNextAction", "title": "ShipOne: Editar siguiente accion" },
      { "command": "shipone.clearNextAction", "title": "ShipOne: Limpiar siguiente accion" },
      { "command": "shipone.openStatusFile", "title": "ShipOne: Abrir STATUS.md", "icon": "$(file-code)" },
      { "command": "shipone.refreshProjects", "title": "ShipOne: Refrescar proyectos", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "shipone.createProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.openProjectQuickPick",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.searchProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.editMvpChecklist",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.markMvpItemDone",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.syncStatusFile",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.focusMode",
          "when": "view == shipone.projectsView && !shipone.focusMode",
          "group": "navigation"
        },
        {
          "command": "shipone.exitFocusMode",
          "when": "view == shipone.projectsView && shipone.focusMode",
          "group": "navigation"
        },
        {
          "command": "shipone.weeklyReview",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.freezeProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.resumeProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.toggleFavorite",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.openStatusFile",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.refreshProjects",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "shipone.openProject",
          "when": "view == shipone.projectsView && viewItem == shipone.project",
          "group": "inline"
        },
        {
          "command": "shipone.changeProjectStatus",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.editNextAction",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.clearNextAction",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.openStatusFile",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.toggleFavorite",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shipone",
          "title": "ShipOne",
          "icon": "media/branding/icon-128.png"
        }
      ]
    },
    "views": {
      "shipone": [
        {
          "id": "shipone.projectsView",
          "name": "ShipOne"
        }
      ]
    },
    "configuration": {
      "title": "ShipOne",
      "properties": {
        "shipone.projectsRoot": {
          "type": "string",
          "default": "C:\\dev\\proyectos",
          "description": "Ruta base donde ShipOne crea y busca proyectos."
        },
        "shipone.defaultVisibility": {
          "type": "string",
          "enum": [
            "private",
            "public"
          ],
          "default": "private",
          "description": "Visibilidad por defecto para nuevos repositorios GitHub."
        },
        "shipone.openAfterCreate": {
          "type": "boolean",
          "default": true,
          "description": "Abrir el proyecto recien creado al terminar."
        },
        "shipone.inactiveWarningDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "description": "Dias sin abrir antes de mostrar aviso de inactividad."
        },
        "shipone.staleWarningDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Dias sin abrir antes de mostrar aviso fuerte."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/vscode": "latest",
    "typescript": "latest"
  }
}
