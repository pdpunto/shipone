{
  "name": "shipone",
  "displayName": "ShipOne",
  "description": "ShipOne ayuda a crear y seguir proyectos desde VS Code",
  "icon": "media/branding/icon-128.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark",
    "image": "media/branding/banner.png"
  },
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:shipone.projectsView",
    "onCommand:shipone.showWelcome",
    "onCommand:shipone.searchProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shipone.showWelcome",
        "title": "ShipOne: Mostrar bienvenida"
      },
      {
        "command": "shipone.createProject",
        "title": "ShipOne: Crear proyecto"
      },
      {
        "command": "shipone.openProjectQuickPick",
        "title": "ShipOne: Abrir proyecto"
      },
      {
        "command": "shipone.searchProject",
        "title": "ShipOne: Buscar proyecto"
      },
      {
        "command": "shipone.openProject",
        "title": "ShipOne: Abrir proyecto"
      },
      {
        "command": "shipone.changeProjectStatus",
        "title": "ShipOne: Cambiar estado"
      },
      {
        "command": "shipone.editNextAction",
        "title": "ShipOne: Editar siguiente acción"
      },
      {
        "command": "shipone.clearNextAction",
        "title": "ShipOne: Limpiar siguiente acción"
      },
      {
        "command": "shipone.openStatusFile",
        "title": "ShipOne: Abrir STATUS.md"
      },
      {
        "command": "shipone.toggleFavorite",
        "title": "ShipOne: Alternar favorito"
      },
      {
        "command": "shipone.refreshProjects",
        "title": "ShipOne: Refrescar proyectos"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "shipone.createProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.openProjectQuickPick",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.searchProject",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        },
        {
          "command": "shipone.refreshProjects",
          "when": "view == shipone.projectsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "shipone.openProject",
          "when": "view == shipone.projectsView && viewItem == shipone.project",
          "group": "inline"
        },
        {
          "command": "shipone.changeProjectStatus",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.editNextAction",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.clearNextAction",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.openStatusFile",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        },
        {
          "command": "shipone.toggleFavorite",
          "when": "view == shipone.projectsView && viewItem == shipone.project"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shipone",
          "title": "ShipOne",
          "icon": "media/branding/icon-128.png"
        }
      ]
    },
    "views": {
      "shipone": [
        {
          "id": "shipone.projectsView",
          "name": "ShipOne"
        }
      ]
    },
    "configuration": {
      "title": "ShipOne",
      "properties": {
        "shipone.projectsRoot": {
          "type": "string",
          "default": "C:\\dev\\proyectos",
          "description": "Ruta base donde ShipOne crea y busca proyectos."
        },
        "shipone.defaultVisibility": {
          "type": "string",
          "enum": [
            "private",
            "public"
          ],
          "default": "private",
          "description": "Visibilidad por defecto para nuevos repositorios GitHub."
        },
        "shipone.openAfterCreate": {
          "type": "boolean",
          "default": true,
          "description": "Abrir el proyecto recién creado al terminar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/vscode": "latest",
    "typescript": "latest"
  }
}
